# Copy this file to `.env` and fill in the real values.
# No secrets are required to build this site.
# `.env` is git-ignored — never commit real values.

# Absolute origin of the deployed site, used for <link rel="canonical">
# and Open Graph / social-sharing URLs. No trailing path.
# Example: https://sic.choithramschool.com
PUBLIC_SITE_URL=https://example.invalid
