---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist on the School Innovation Council site."
  noindex
>
  <section class="section">
    <div class="wrap">
      <div class="empty-state">
        <span class="eyebrow">404</span>
        <h1>There is no page at this address</h1>
        <p>
          The link may be out of date. The council’s activity, mission and
          committee are all one click away from the home page.
        </p>
        <p>
          <a class="link-arrow" href="/">Back to the home page</a>
        </p>
        <p>
          <a class="link-arrow" href="/events/">What’s on this session</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
